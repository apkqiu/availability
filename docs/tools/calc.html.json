{"title": "\u8ba1\u7b97\u5668\n", "title_in": "\u8ba1\u7b97\u5668\n", "body": "<input class=\"w-100 form-control\" id=\"calc_input\" placeholder=\"\u8f93\u5165\u8868\u8fbe\u5f0f\" type=\"text\"/>\n<p id=\"calc_result\">\n</p>\n<script>\n</script>\n<script>\n !(function() {\n                        \n                    calc_input.addEventListener(\"input\", function() {\n                        \n\tfunction change(exp) {\n\t\t// \u81ea\u5df1\u5b9e\u73b0\uff01\n\t\tconst level = {\n\t\t\t'+': 1,\n\t\t\t'-': 1,\n\t\t\t'*': 2,\n\t\t\t'/': 2,\n\t\t\t'(': 0,\n\t\t\t')': 0,\n\t\t\t0: -1,\n\t\t\t1: -1,\n\t\t\t2: -1,\n\t\t\t3: -1,\n\t\t\t4: -1,\n\t\t\t5: -1,\n\t\t\t6: -1,\n\t\t\t7: -1,\n\t\t\t8: -1,\n\t\t\t9: -1,\n\t\t\t'.': -1,\n\t\t};\n\t\tconst stack = [];\n\t\tconst output = [];\n\t\tfor (let i = 0; i < exp.length; i++) {\n\t\t\t// \u7b97\u5f0f\u91cc\u9762\u5305\u542b2\u4f4d\u6570\u4ee5\u4e0a\u7684\u6570\u5b57\uff0c\u8fd0\u7b97\u4f18\u5148\u7ea7\u5b58\u5728level\u91cc\u9762\uff0c\u7136\u540e\u4e3a\u201c+-\u201d\u7279\u5224\u662f\u5426\u4e3a\u5f00\u5934\u7684\u7b26\u53f7\uff08\u6bd4\u5982\u201c-1\u201d\u8f6c\u6362\u4e3a\u201c0-1\u201d\uff09\n\t\t\tif (level[exp[i]] == 1 && (i == 0 || level[exp[i - 1]] == 0)) {\n\t\t\t\toutput.push('0');\n\t\t\t}\n\t\t\tif (level[exp[i]] == -1) {\n\t\t\t\tlet num = exp[i];\n\t\t\t\twhile (i + 1 < exp.length && level[exp[i + 1]] == -1) {\n\t\t\t\t\tnum += exp[i + 1];\n\t\t\t\t\ti++;\n\t\t\t\t}\n\t\t\t\toutput.push(num);\n\t\t\t} else {\n\t\t\t\tif (exp[i] == '(') {\n\t\t\t\t\tstack.push(exp[i]);\n\t\t\t\t} else if (exp[i] == ')') {\n\t\t\t\t\twhile (stack[stack.length - 1] != '(') {\n\t\t\t\t\t\toutput.push(stack.pop());\n\t\t\t\t\t}\n\t\t\t\t\tstack.pop();\n\t\t\t\t} else {\n\t\t\t\t\twhile (stack.length != 0 && level[stack[stack.length - 1]] >= level[exp[i]]) {\n\t\t\t\t\t\toutput.push(stack.pop());\n\t\t\t\t\t}\n\t\t\t\t\tstack.push(exp[i]);\n\t\t\t\t}\n\t\t\t}\n\n\t\t}\n\t\twhile (stack.length > 0) {\n\t\t\toutput.push(stack.pop());\n\t\t}\n\t\treturn output;\n\t}\n\tconst gcd = (a, b) => {\n\t\treturn b ? gcd(b, a % b) : a;\n\t};\n\tconst add_frac = (a, b) => {\n\t\t\treturn [a[0] * b[1] + b[0] * a[1], a[1] * b[1]];\n\t\t},\n\t\tsub_frac = (a, b) => {\n\t\t\treturn [a[0] * b[1] - b[0] * a[1], a[1] * b[1]];\n\t\t},\n\t\tmul_frac = (a, b) => {\n\t\t\treturn [a[0] * b[0], a[1] * b[1]];\n\t\t},\n\t\tdiv_frac = (a, b) => {\n\t\t\treturn [a[0] * b[1], a[1] * b[0]];\n\t\t},\n\t\tto_frac = (a) => {\n\t\t\tif (typeof a === 'object') {\n\t\t\t\treturn a;\n\t\t\t}\n\n\t\t\tvar b = BigInt(1);\n            var pos = a.indexOf(\".\");\n            if(pos==-1){\n                return [BigInt((a)),BigInt(1)];\n            }\n\t\t\tfor (var i = 0;i < a.length-pos-1;i++) {\n\t\t\t\tb *= BigInt(10);\n\t\t\t}\n\t\t\treturn [BigInt((a.replace(\".\",\"\"))), b];\n\t\t},\n\t\tmin_frac = (a) => {\n            var g = gcd(a[0], a[1]);\n            if(a[0]<0&&g>0) g = -g;\n            if(a[1]>0&&g<0) g = -g;\n\t\t\treturn [a[0] / g, a[1] / g];\n\t\t},\n\t\tstr_frac = (a) => {\n            a = min_frac(a);\n            if (a[1] == 1) {\n                return a[0];\n            }\n            var val_str;\n            const MAX_SAFE_INTEGER = 9007199254740991n;\n            if(a[0]<=MAX_SAFE_INTEGER &&a[1]<=MAX_SAFE_INTEGER ){\n                // \u53ef\u8ba1\u7b97\u8303\u56f4\n                var about_value = parseInt(a[0]) / parseInt(a[1]);\n                val_str = about_value.toFixed(10);\n                // \u5220\u9664\u591a\u4f59\u76840\n                var lastindex = val_str.length-1;\n                for(;val_str[lastindex] == '0';lastindex--);\n                val_str = val_str.substring(0, lastindex+1)\n                // \u591a\u4e86\u5c0f\u6570\u70b9\uff1f\u53bb\u6389\n                if (val_str.indexOf('.') == val_str.length-1){\n                    val_str = val_str.substring(0, val_str.length-1)\n                } \n            }else{\n                var about_value = a[0]/a[1];\n                val_str = \"\u7ea6\u7b49\u4e8e \"+about_value.toString();\n            }\n            return a[0] + '/' + a[1] + \" (\" + val_str + \")\";\n\t\t};\n\tfunction calc(exp) {\n\t\tconst input = change(exp); //\u8f6c\u540e\u7f00\n\t\tconst stack = [];\n\t\tfor (let i = 0; i < input.length; i++) {\n\t\t\tconst token = input[i];\n\t\t\tif (\"+-*/\".indexOf(token)!=-1) {\n\t\t\t\tconst b = stack.pop();\n\t\t\t\tconst a = stack.pop();\n\t\t\t\tswitch (token) {\n\t\t\t\t\tcase '+':\n\t\t\t\t\t\tstack.push(add_frac(a,b));\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase '-':\n\t\t\t\t\t\tstack.push(sub_frac(a,b));\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase '*':\n\t\t\t\t\t\tstack.push(mul_frac(a,b));\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase '/':\n\t\t\t\t\t\tstack.push(div_frac(a,b));\n\t\t\t\t\t\tbreak;\n\t\t\t\t}\n                stack.push(min_frac(stack.pop()))\n\t\t\t} else {\n\t\t\t\tstack.push(to_frac(token));\n\t\t\t}\n        }\n        var res = stack.pop();\n\t\tif (typeof res === 'object') return str_frac(min_frac(res));\n\t\treturn res;\n\t}\n\tvar input = this.value;\n    if(!input){\n        $('#calc_result').text(\"\");\n        return;\n    }\n    try{\n        var result = calc(input);\n        $('#calc_result').text(\"=\"+result);\n    }catch{\n        $('#calc_result').text(\"\u8ba1\u7b97\u51fa\u9519\")\n    }\n\n                    });\n                \n                    })();\n</script>\n", "rootdef": ".."}