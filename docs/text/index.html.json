{"title": "\u6d3d\u9690\u5c71\u623f | \u5b66\u751f\u521b\u4f5c\n", "title_in": "\u6d3d\u9690\u5c71\u623f | \u5b66\u751f\u521b\u4f5c\n", "body": "<h1>\n \u5b66\u751f\u521b\u4f5c\n</h1>\n<style>\n a {\n\t\ttext-decoration: none;\n\t}\n\t.preview {\n\t\twidth: 100%;\n\t\toverflow: hidden;\n\t\ttext-overflow: ellipsis;\n\t\twhite-space: nowrap;\n\t\theight: 3em;\n\t}\n</style>\n<div id=\"students_text\">\n</div>\n<div class=\"row\">\n <div class=\"col-md-6\">\n  <h3>\n   \u8bd7\n  </h3>\n  <ul class=\"list-group list-group-flush\" id=\"sp\">\n  </ul>\n </div>\n <div class=\"col-md-6\">\n  <h3>\n   \u8bcd\n  </h3>\n  <ul class=\"list-group list-group-flush\" id=\"sw\">\n  </ul>\n  <h3>\n   \u66f2\n  </h3>\n  <ul class=\"list-group list-group-flush\" id=\"ss\">\n  </ul>\n  <h3>\n   \u4e66\u6cd5\n  </h3>\n  <ul class=\"list-group list-group-flush\" id=\"sc\">\n  </ul>\n </div>\n</div>\n<script>\n !(function() {\n                        \n\t$('#students_text').html('<div class=\"spinner-border\"></div>');\n\t$.get('index.json').then(function (data) {\n\t\t$('#students_text').html('');\n\t\tvar texts = {};\n\t\t// key: title, value: url\n\t\tfor (var key in data) {\n\t\t\tvar url = data[key];\n\t\t\ttype = url[0];\n\t\t\ttexts[type] = texts[type] || [];\n\t\t\ttexts[type].push({ key: key, url: url });\n\t\t}\n\t\tfor (var type in texts) {\n\t\t\tvar list = texts[type];\n\t\t\tvar html = '';\n\t\t\tfor (var i = 0; i < list.length; i++) {\n\t\t\t\tvar item = list[i];\n\t\t\t\thtml +=\n\t\t\t\t\t'<li class=\"list-group-item list-group-item-action\"><a href=\"' +\n\t\t\t\t\titem.url +\n\t\t\t\t\t'\">' +\n\t\t\t\t\titem.key.replace(/<b>[\\u0000-\\uffff]+<\\/b> /, '') +\n\t\t\t\t\t'</a></li>';\n\t\t\t}\n\t\t\t$('#s' + type).html(html);\n\t\t}\n\t});\n\n                    })();\n</script>\n", "rootdef": ".."}