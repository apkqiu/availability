{
    "rootdef": "\u5173\u6ce8</h1>\u8fd1\u65e5\uff0c\u4e00\u573a\u53d1\u751f\u5728\u4fe1\u606f\u8bfe\u540e\u7684U\u76d8\u201c\u98ce\u6ce2\u201d\uff0c\u5438\u5f15\u4e86\u5e08\u751f\u4eec\u7684\u5173\u6ce8\u3002<br>\u8bfe\u95f4\uff0c\u674e\u519b\u660a\u540c\u5b66\u672a\u7ecf\u5434\u9e23\u8001\u5e08\u8bb8\u53ef\uff0c\u8bd5\u56fe\u5c06\u5176U\u76d8\u4e2d\u7684\u5185\u5bb9\u590d\u5236\u5230\u81ea\u5df1\u7684U\u76d8\u4e2d\uff0c\u8fd9\u4e00\u884c\u4e3a\u88ab\u4fe1\u606f\u8001\u5e08\u654f\u9510\u5bdf\u89c9\u3002\u540c\u5728\u6b64\u4e8b\u4e2d\u6709\u53c2\u4e0e\u7684\u674e\u9a6d\u660a\u540c\u5b66\u89c1\u52bf\u4e0d\u5999\uff0c\u6025\u5fd9\u62d4\u51faU\u76d8\uff0c\u5374\u4f9d\u65e7\u6ca1\u80fd\u9003\u8fc7\u8001\u5e08\u7684\u773c\u775b\u3002\u5173\u952e\u65f6\u523b\uff0c\u674e\u519b\u660a\u9009\u62e9\u201c\u5f03\u8f66\u4fdd\u5e05\u201d\uff0c\u4fdd\u4f4f\u4e86\u5b58\u6709\u590d\u5236\u5185\u5bb9\u7684U\u76d8\u3002<br>\u4fe1\u606f\u8001\u5e08\u4e3a\u5f7b\u67e5\u6b64\u4e8b\uff0c\u8be2\u95ee\u4fe1\u606f\u8bfe\u4ee3\u8868\u73ed\u4e0a\u8fd8\u6709\u8c01\u643a\u5e26\u4e86U\u76d8\uff0c\u8bfe\u4ee3\u8868\u5982\u5b9e\u8bf4\u51fa\u674e\u519b\u660a\u3002\u88ab\u53d1\u73b0\u540e\uff0c\u4fe1\u606f\u8001\u5e08\u8981\u6c42\u674e\u519b\u660a\u6253\u5f00U\u76d8\u68c0\u67e5\uff0c\u4ee5\u8bc1\u6e05\u767d\u3002\u5c31\u5728\u4fe1\u606f\u8001\u5e08\u77ed\u6682\u8d70\u795e\u4e4b\u9645\uff0c\u674e\u519b\u660a\u8fc5\u901f\u6253\u5f00\u300a\u897f\u6e38\u8bb0\u300b\u7684PPT\uff0c\u5de7\u5999\u4f2a\u88c5\u3002\u8001\u5e08\u67e5\u770b\u65f6\uff0c\u672a\u53d1\u73b0\u5f02\u5e38\u5185\u5bb9\uff0c\u674e\u519b\u660a\u5c31\u6b64\u201c\u521b\u9020\u5947\u8ff9\u201d\uff0c\u6210\u529f\u8eb2\u8fc7\u68c0\u67e5\u3002<br>\u6b64\u4e8b\u5728\u6821\u56ed\u5185\u5f15\u53d1\u70ed\u8bae\uff0c\u90e8\u5206\u540c\u5b66\u5bf9\u674e\u519b\u660a\u7684\u201c\u673a\u667a\u201d\u8868\u793a\u60ca\u8bb6\uff0c\u4e5f\u6709\u540c\u5b66\u8ba4\u4e3a\u8fd9\u79cd\u672a\u7ecf\u5141\u8bb8\u590d\u5236\u4ed6\u4eba\u8d44\u6599\u7684\u884c\u4e3a\u5e76\u4e0d\u6070\u5f53\u3002\u5b66\u6821\u65b9\u9762\u8868\u793a\uff0c\u5c06\u52a0\u5f3a\u5bf9\u5b66\u751f\u7684\u4fe1\u606f\u9053\u5fb7\u548c\u884c\u4e3a\u89c4\u8303\u6559\u80b2\uff0c\u907f\u514d\u7c7b\u4f3c\u4e8b\u4ef6\u518d\u6b21\u53d1\u751f\u3002",
    "title": "\u5f15\u53d1\u5173\u6ce8</h1>\u8fd1\u65e5\uff0c\u4e00\u573a\u53d1\u751f\u5728\u4fe1\u606f\u8bfe\u540e\u7684U\u76d8\u201c\u98ce\u6ce2\u201d\uff0c\u5438\u5f15\u4e86\u5e08\u751f\u4eec\u7684\u5173\u6ce8\u3002<br>\u8bfe\u95f4\uff0c\u674e\u519b\u660a\u540c\u5b66\u672a\u7ecf\u5434\u9e23\u8001\u5e08\u8bb8\u53ef\uff0c\u8bd5\u56fe\u5c06\u5176U\u76d8\u4e2d\u7684\u5185\u5bb9\u590d\u5236\u5230\u81ea\u5df1\u7684U\u76d8\u4e2d\uff0c\u8fd9\u4e00\u884c\u4e3a\u88ab\u4fe1\u606f\u8001\u5e08\u654f\u9510\u5bdf\u89c9\u3002\u540c\u5728\u6b64\u4e8b\u4e2d\u6709\u53c2\u4e0e\u7684\u674e\u9a6d\u660a\u540c\u5b66\u89c1\u52bf\u4e0d\u5999\uff0c\u6025\u5fd9\u62d4\u51faU\u76d8\uff0c\u5374\u4f9d\u65e7\u6ca1\u80fd\u9003\u8fc7\u8001\u5e08\u7684\u773c\u775b\u3002\u5173\u952e\u65f6\u523b\uff0c\u674e\u519b\u660a\u9009\u62e9\u201c\u5f03\u8f66\u4fdd\u5e05\u201d\uff0c\u4fdd\u4f4f\u4e86\u5b58\u6709\u590d\u5236\u5185\u5bb9\u7684U\u76d8\u3002<br>\u4fe1\u606f\u8001\u5e08\u4e3a\u5f7b\u67e5\u6b64\u4e8b\uff0c\u8be2\u95ee\u4fe1\u606f\u8bfe\u4ee3\u8868\u73ed\u4e0a\u8fd8\u6709\u8c01\u643a\u5e26\u4e86U\u76d8\uff0c\u8bfe\u4ee3\u8868\u5982\u5b9e\u8bf4\u51fa\u674e\u519b\u660a\u3002\u88ab\u53d1\u73b0\u540e\uff0c\u4fe1\u606f\u8001\u5e08\u8981\u6c42\u674e\u519b\u660a\u6253\u5f00U\u76d8\u68c0\u67e5\uff0c\u4ee5\u8bc1\u6e05\u767d\u3002\u5c31\u5728\u4fe1\u606f\u8001\u5e08\u77ed\u6682\u8d70\u795e\u4e4b\u9645\uff0c\u674e\u519b\u660a\u8fc5\u901f\u6253\u5f00\u300a\u897f\u6e38\u8bb0\u300b\u7684PPT\uff0c\u5de7\u5999\u4f2a\u88c5\u3002\u8001\u5e08\u67e5\u770b\u65f6\uff0c\u672a\u53d1\u73b0\u5f02\u5e38\u5185\u5bb9\uff0c\u674e\u519b\u660a\u5c31\u6b64\u201c\u521b\u9020\u5947\u8ff9\u201d\uff0c\u6210\u529f\u8eb2\u8fc7\u68c0\u67e5\u3002<br>\u6b64\u4e8b\u5728\u6821\u56ed\u5185\u5f15\u53d1\u70ed\u8bae\uff0c\u90e8\u5206\u540c\u5b66\u5bf9\u674e\u519b\u660a\u7684\u201c\u673a\u667a\u201d\u8868\u793a\u60ca\u8bb6\uff0c\u4e5f\u6709\u540c\u5b66\u8ba4\u4e3a\u8fd9\u79cd\u672a\u7ecf\u5141\u8bb8\u590d\u5236\u4ed6\u4eba\u8d44\u6599\u7684\u884c\u4e3a\u5e76\u4e0d\u6070\u5f53\u3002\u5b66\u6821\u65b9\u9762\u8868\u793a\uff0c\u5c06\u52a0\u5f3a\u5bf9\u5b66\u751f\u7684\u4fe1\u606f\u9053\u5fb7\u548c\u884c\u4e3a\u89c4\u8303\u6559\u80b2\uff0c\u907f\u514d\u7c7b\u4f3c\u4e8b\u4ef6\u518d\u6b21\u53d1\u751f\u3002",
    "title_in": "\u6ce8</h1>\u8fd1\u65e5\uff0c\u4e00\u573a\u53d1\u751f\u5728\u4fe1\u606f\u8bfe\u540e\u7684U\u76d8\u201c\u98ce\u6ce2\u201d\uff0c\u5438\u5f15\u4e86\u5e08\u751f\u4eec\u7684\u5173\u6ce8\u3002<br>\u8bfe\u95f4\uff0c\u674e\u519b\u660a\u540c\u5b66\u672a\u7ecf\u5434\u9e23\u8001\u5e08\u8bb8\u53ef\uff0c\u8bd5\u56fe\u5c06\u5176U\u76d8\u4e2d\u7684\u5185\u5bb9\u590d\u5236\u5230\u81ea\u5df1\u7684U\u76d8\u4e2d\uff0c\u8fd9\u4e00\u884c\u4e3a\u88ab\u4fe1\u606f\u8001\u5e08\u654f\u9510\u5bdf\u89c9\u3002\u540c\u5728\u6b64\u4e8b\u4e2d\u6709\u53c2\u4e0e\u7684\u674e\u9a6d\u660a\u540c\u5b66\u89c1\u52bf\u4e0d\u5999\uff0c\u6025\u5fd9\u62d4\u51faU\u76d8\uff0c\u5374\u4f9d\u65e7\u6ca1\u80fd\u9003\u8fc7\u8001\u5e08\u7684\u773c\u775b\u3002\u5173\u952e\u65f6\u523b\uff0c\u674e\u519b\u660a\u9009\u62e9\u201c\u5f03\u8f66\u4fdd\u5e05\u201d\uff0c\u4fdd\u4f4f\u4e86\u5b58\u6709\u590d\u5236\u5185\u5bb9\u7684U\u76d8\u3002<br>\u4fe1\u606f\u8001\u5e08\u4e3a\u5f7b\u67e5\u6b64\u4e8b\uff0c\u8be2\u95ee\u4fe1\u606f\u8bfe\u4ee3\u8868\u73ed\u4e0a\u8fd8\u6709\u8c01\u643a\u5e26\u4e86U\u76d8\uff0c\u8bfe\u4ee3\u8868\u5982\u5b9e\u8bf4\u51fa\u674e\u519b\u660a\u3002\u88ab\u53d1\u73b0\u540e\uff0c\u4fe1\u606f\u8001\u5e08\u8981\u6c42\u674e\u519b\u660a\u6253\u5f00U\u76d8\u68c0\u67e5\uff0c\u4ee5\u8bc1\u6e05\u767d\u3002\u5c31\u5728\u4fe1\u606f\u8001\u5e08\u77ed\u6682\u8d70\u795e\u4e4b\u9645\uff0c\u674e\u519b\u660a\u8fc5\u901f\u6253\u5f00\u300a\u897f\u6e38\u8bb0\u300b\u7684PPT\uff0c\u5de7\u5999\u4f2a\u88c5\u3002\u8001\u5e08\u67e5\u770b\u65f6\uff0c\u672a\u53d1\u73b0\u5f02\u5e38\u5185\u5bb9\uff0c\u674e\u519b\u660a\u5c31\u6b64\u201c\u521b\u9020\u5947\u8ff9\u201d\uff0c\u6210\u529f\u8eb2\u8fc7\u68c0\u67e5\u3002<br>\u6b64\u4e8b\u5728\u6821\u56ed\u5185\u5f15\u53d1\u70ed\u8bae\uff0c\u90e8\u5206\u540c\u5b66\u5bf9\u674e\u519b\u660a\u7684\u201c\u673a\u667a\u201d\u8868\u793a\u60ca\u8bb6\uff0c\u4e5f\u6709\u540c\u5b66\u8ba4\u4e3a\u8fd9\u79cd\u672a\u7ecf\u5141\u8bb8\u590d\u5236\u4ed6\u4eba\u8d44\u6599\u7684\u884c\u4e3a\u5e76\u4e0d\u6070\u5f53\u3002\u5b66\u6821\u65b9\u9762\u8868\u793a\uff0c\u5c06\u52a0\u5f3a\u5bf9\u5b66\u751f\u7684\u4fe1\u606f\u9053\u5fb7\u548c\u884c\u4e3a\u89c4\u8303\u6559\u80b2\uff0c\u907f\u514d\u7c7b\u4f3c\u4e8b\u4ef6\u518d\u6b21\u53d1\u751f\u3002",
    "outbody": "\u5173\u6ce8</h1>\u8fd1\u65e5\uff0c\u4e00\u573a\u53d1\u751f\u5728\u4fe1\u606f\u8bfe\u540e\u7684U\u76d8\u201c\u98ce\u6ce2\u201d\uff0c\u5438\u5f15\u4e86\u5e08\u751f\u4eec\u7684\u5173\u6ce8\u3002<br>\u8bfe\u95f4\uff0c\u674e\u519b\u660a\u540c\u5b66\u672a\u7ecf\u5434\u9e23\u8001\u5e08\u8bb8\u53ef\uff0c\u8bd5\u56fe\u5c06\u5176U\u76d8\u4e2d\u7684\u5185\u5bb9\u590d\u5236\u5230\u81ea\u5df1\u7684U\u76d8\u4e2d\uff0c\u8fd9\u4e00\u884c\u4e3a\u88ab\u4fe1\u606f\u8001\u5e08\u654f\u9510\u5bdf\u89c9\u3002\u540c\u5728\u6b64\u4e8b\u4e2d\u6709\u53c2\u4e0e\u7684\u674e\u9a6d\u660a\u540c\u5b66\u89c1\u52bf\u4e0d\u5999\uff0c\u6025\u5fd9\u62d4\u51faU\u76d8\uff0c\u5374\u4f9d\u65e7\u6ca1\u80fd\u9003\u8fc7\u8001\u5e08\u7684\u773c\u775b\u3002\u5173\u952e\u65f6\u523b\uff0c\u674e\u519b\u660a\u9009\u62e9\u201c\u5f03\u8f66\u4fdd\u5e05\u201d\uff0c\u4fdd\u4f4f\u4e86\u5b58\u6709\u590d\u5236\u5185\u5bb9\u7684U\u76d8\u3002<br>\u4fe1\u606f\u8001\u5e08\u4e3a\u5f7b\u67e5\u6b64\u4e8b\uff0c\u8be2\u95ee\u4fe1\u606f\u8bfe\u4ee3\u8868\u73ed\u4e0a\u8fd8\u6709\u8c01\u643a\u5e26\u4e86U\u76d8\uff0c\u8bfe\u4ee3\u8868\u5982\u5b9e\u8bf4\u51fa\u674e\u519b\u660a\u3002\u88ab\u53d1\u73b0\u540e\uff0c\u4fe1\u606f\u8001\u5e08\u8981\u6c42\u674e\u519b\u660a\u6253\u5f00U\u76d8\u68c0\u67e5\uff0c\u4ee5\u8bc1\u6e05\u767d\u3002\u5c31\u5728\u4fe1\u606f\u8001\u5e08\u77ed\u6682\u8d70\u795e\u4e4b\u9645\uff0c\u674e\u519b\u660a\u8fc5\u901f\u6253\u5f00\u300a\u897f\u6e38\u8bb0\u300b\u7684PPT\uff0c\u5de7\u5999\u4f2a\u88c5\u3002\u8001\u5e08\u67e5\u770b\u65f6\uff0c\u672a\u53d1\u73b0\u5f02\u5e38\u5185\u5bb9\uff0c\u674e\u519b\u660a\u5c31\u6b64\u201c\u521b\u9020\u5947\u8ff9\u201d\uff0c\u6210\u529f\u8eb2\u8fc7\u68c0\u67e5\u3002<br>\u6b64\u4e8b\u5728\u6821\u56ed\u5185\u5f15\u53d1\u70ed\u8bae\uff0c\u90e8\u5206\u540c\u5b66\u5bf9\u674e\u519b\u660a\u7684\u201c\u673a\u667a\u201d\u8868\u793a\u60ca\u8bb6\uff0c\u4e5f\u6709\u540c\u5b66\u8ba4\u4e3a\u8fd9\u79cd\u672a\u7ecf\u5141\u8bb8\u590d\u5236\u4ed6\u4eba\u8d44\u6599\u7684\u884c\u4e3a\u5e76\u4e0d\u6070\u5f53\u3002\u5b66\u6821\u65b9\u9762\u8868\u793a\uff0c\u5c06\u52a0\u5f3a\u5bf9\u5b66\u751f\u7684\u4fe1\u606f\u9053\u5fb7\u548c\u884c\u4e3a\u89c4\u8303\u6559\u80b2\uff0c\u907f\u514d\u7c7b\u4f3c\u4e8b\u4ef6\u518d\u6b21\u53d1\u751f\u3002",
    "body": "\u201d\u5f15\u53d1\u5173\u6ce8</h1>\u8fd1\u65e5\uff0c\u4e00\u573a\u53d1\u751f\u5728\u4fe1\u606f\u8bfe\u540e\u7684U\u76d8\u201c\u98ce\u6ce2\u201d\uff0c\u5438\u5f15\u4e86\u5e08\u751f\u4eec\u7684\u5173\u6ce8\u3002<br>\u8bfe\u95f4\uff0c\u674e\u519b\u660a\u540c\u5b66\u672a\u7ecf\u5434\u9e23\u8001\u5e08\u8bb8\u53ef\uff0c\u8bd5\u56fe\u5c06\u5176U\u76d8\u4e2d\u7684\u5185\u5bb9\u590d\u5236\u5230\u81ea\u5df1\u7684U\u76d8\u4e2d\uff0c\u8fd9\u4e00\u884c\u4e3a\u88ab\u4fe1\u606f\u8001\u5e08\u654f\u9510\u5bdf\u89c9\u3002\u540c\u5728\u6b64\u4e8b\u4e2d\u6709\u53c2\u4e0e\u7684\u674e\u9a6d\u660a\u540c\u5b66\u89c1\u52bf\u4e0d\u5999\uff0c\u6025\u5fd9\u62d4\u51faU\u76d8\uff0c\u5374\u4f9d\u65e7\u6ca1\u80fd\u9003\u8fc7\u8001\u5e08\u7684\u773c\u775b\u3002\u5173\u952e\u65f6\u523b\uff0c\u674e\u519b\u660a\u9009\u62e9\u201c\u5f03\u8f66\u4fdd\u5e05\u201d\uff0c\u4fdd\u4f4f\u4e86\u5b58\u6709\u590d\u5236\u5185\u5bb9\u7684U\u76d8\u3002<br>\u4fe1\u606f\u8001\u5e08\u4e3a\u5f7b\u67e5\u6b64\u4e8b\uff0c\u8be2\u95ee\u4fe1\u606f\u8bfe\u4ee3\u8868\u73ed\u4e0a\u8fd8\u6709\u8c01\u643a\u5e26\u4e86U\u76d8\uff0c\u8bfe\u4ee3\u8868\u5982\u5b9e\u8bf4\u51fa\u674e\u519b\u660a\u3002\u88ab\u53d1\u73b0\u540e\uff0c\u4fe1\u606f\u8001\u5e08\u8981\u6c42\u674e\u519b\u660a\u6253\u5f00U\u76d8\u68c0\u67e5\uff0c\u4ee5\u8bc1\u6e05\u767d\u3002\u5c31\u5728\u4fe1\u606f\u8001\u5e08\u77ed\u6682\u8d70\u795e\u4e4b\u9645\uff0c\u674e\u519b\u660a\u8fc5\u901f\u6253\u5f00\u300a\u897f\u6e38\u8bb0\u300b\u7684PPT\uff0c\u5de7\u5999\u4f2a\u88c5\u3002\u8001\u5e08\u67e5\u770b\u65f6\uff0c\u672a\u53d1\u73b0\u5f02\u5e38\u5185\u5bb9\uff0c\u674e\u519b\u660a\u5c31\u6b64\u201c\u521b\u9020\u5947\u8ff9\u201d\uff0c\u6210\u529f\u8eb2\u8fc7\u68c0\u67e5\u3002<br>\u6b64\u4e8b\u5728\u6821\u56ed\u5185\u5f15\u53d1\u70ed\u8bae\uff0c\u90e8\u5206\u540c\u5b66\u5bf9\u674e\u519b\u660a\u7684\u201c\u673a\u667a\u201d\u8868\u793a\u60ca\u8bb6\uff0c\u4e5f\u6709\u540c\u5b66\u8ba4\u4e3a\u8fd9\u79cd\u672a\u7ecf\u5141\u8bb8\u590d\u5236\u4ed6\u4eba\u8d44\u6599\u7684\u884c\u4e3a\u5e76\u4e0d\u6070\u5f53\u3002\u5b66\u6821\u65b9\u9762\u8868\u793a\uff0c\u5c06\u52a0\u5f3a\u5bf9\u5b66\u751f\u7684\u4fe1\u606f\u9053\u5fb7\u548c\u884c\u4e3a\u89c4\u8303\u6559\u80b2\uff0c\u907f\u514d\u7c7b\u4f3c\u4e8b\u4ef6\u518d\u6b21\u53d1\u751f\u3002"
}