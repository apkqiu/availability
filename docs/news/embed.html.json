{"title": "\u5c4f\u5c71\u542c\u7011 | \u65b0\u95fb\n", "title_in": "\u5c4f\u5c71\u542c\u7011 | \u65b0\u95fb\n", "body": "<style>\n .list-group-item,\n    .list-group-item {\n        background: transparent;\n    }\n</style>\n<br/>\n<a class=\"btn\" href=\"index.html\">\n \u56de\u5230\u9996\u9875\n</a>\n<hr/>\n<div class=\"row\">\n <div class=\"col-8\" id=\"content\" style=\"backdrop-filter: blur(10px);\">\n </div>\n <div class=\"col-4\" id=\"ads\">\n  <h4>\n   \u4eba\u4eba\u5173\u6ce8\n  </h4>\n  <ul class=\"list-group list-group-flush\" id=\"recommend\">\n  </ul>\n </div>\n</div>\n<br/>\n<br/>\n<script>\n !(function() {\n                        \n\t$(\"#content\").html('<div class=\"spinner-border\"></div>');\n\n    var resource = window.location.hash.substring(1);\n    if (resource !== \"\") {\n        $.get(\"content/\"+resource).then(function (data) {\n            data = data.replace(/(.+).files/g, \"newspaper/$1.files\");\n            $(\"#content\").html(data);\n        })\n    }else{\n        $(\"#content\").html(\"\u6ca1\u6709\u627e\u5230\u8d44\u6e90\uff0c\u8bf7\u68c0\u67e5URL\");\n    }\n\t$(\"#recommend\").html('<div class=\"spinner-border\"></div>');\n    $.get(\"popular.json\").then(function (data) {\n        $(\"#recommend\").html(\"\");\n        // key: title, value: url\n        for (var key in data) {\n            var url = data[key]\n            if(url.startsWith(\"!\")){\n                url = \"pdf_embed.html#\" + url.substring(1)\n            }else{\n                url = \"embed.html#\" + url\n            }\n            $(\"#recommend\").append(\"<li class='list-group-item'><a href='\" + url + \"'>\" + key + \"</a></li>\");\n        }\n    })\n\n                    })();\n</script>\n", "rootdef": ".."}