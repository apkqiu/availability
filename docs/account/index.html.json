{"title": "\u67f3\u836b\u7720\u7434 | \u8bbe\u7f6e\n", "title_in": "\u67f3\u836b\u7720\u7434 | \u8bbe\u7f6e\n", "body": "<h1>\n \u8bbe\u7f6e\n</h1>\n<h4 id=\"personalization\">\n \u4e2a\u6027\u5316\n</h4>\n<div class=\"form-check form-switch\">\n <input class=\"form-check-input\" id=\"adv_bg\" onchange=\"save('adv_bg',this.checked)\" role=\"switch\" type=\"checkbox\"/>\n <label class=\"form-check-label\" for=\"adv_bg\">\n  \u9ad8\u7ea7\u80cc\u666f\n </label>\n</div>\n<br/>\n<div class=\"mb-3 row\" id=\"basic_bg\">\n <label class=\"col-form-label col-sm-2\" for=\"color\">\n  \u80cc\u666f\u989c\u8272\n </label>\n <div class=\"col-sm-10\">\n  <input class=\"form-control form-control-color\" id=\"color\" onchange=\"save('color',this.value)\" style=\"display: inline-block\" type=\"color\"/>\n </div>\n</div>\n<div id=\"advanced_bg\">\n <div class=\"mb-3 row\">\n  <label class=\"col-form-label col-sm-2\" for=\"bg\">\n   \u80cc\u666f\u56fe\u7247\n  </label>\n  <div class=\"col-sm-10\">\n   <select class=\"form-select\" id=\"imgbg\" onchange=\"save('imgbg',this.value)\">\n    <option disabled=\"\">\n     \u5b66\u6821\n    </option>\n    <option value=\"SchoolGate.jpg\">\n     \u6821\u95e8\u53e3\n    </option>\n    <option value=\"bg.jpg\">\n     \u540e\u82b1\u56ed\n    </option>\n    <option value=\"bg-1.jpg\">\n     \u60e0\u836b\u56ed\n    </option>\n    <hr/>\n    <option disabled=\"\">\n     \u57ce\u5e02\n    </option>\n    <option value=\"bg-2.png\">\n     \u56db\u5ddd\uff0c\u6210\u90fd \u00b7 \u6210\u90fd\u975e\u9057\u535a\u89c8\u56ed\u7f07\u6c83\u4e3d\u9152\u5e97\n    </option>\n    <option value=\"bg-4.jpg\">\n     \u5b89\u5fbd\uff0c\u6cfe\u53bf \u00b7 \u6cfe\u53bf\u6c49\u5510\u7eb8\u574a\u666f\u533a\n    </option>\n    <hr/>\n    <option disabled=\"\">\n     \u5176\u4ed6\n    </option>\n    <option value=\"bg-17.1.jpg\">\n     \u672a\u547d\u540d\uff08\u548c\u8c10\u7248\uff09\n    </option>\n    <hr/>\n    <option disabled=\"\">\n     \u81ea\u5b9a\u4e49\n    </option>\n    <option value=\"custom\">\n     \u81ea\u5b9a\u4e49\n    </option>\n    <hr/>\n    <option disabled=\"\">\n     \u7981\u7528\uff08\u4f60\u53ef\u4ee5\u8bd5\u8bd5\u5361\u51fa\u6765\u8fd9\u4e9b\u56fe\u7247\uff09\n    </option>\n    <option disabled=\"\" value=\"bg-3.jpg\">\n     \u672a\u547d\u540d\uff0cbg-3.jpg\n    </option>\n    <option disabled=\"\" value=\"bg-7.jpg\">\n     \u672a\u547d\u540d\uff0cbg-7.jpg\n    </option>\n    <option disabled=\"\" value=\"bg-10.jpg\">\n     \u672a\u547d\u540d\uff0cbg-10.jpg\n    </option>\n    <option disabled=\"\" value=\"bg-13.jpg\">\n     \u672a\u547d\u540d\uff0cbg-13.jpg\n    </option>\n    <option disabled=\"\" value=\"bg-16.jpg\">\n     \u672a\u547d\u540d\uff0cbg-16.jpg\n    </option>\n    <option disabled=\"\" value=\"bg-17.jpg\">\n     \u672a\u547d\u540d\uff0cbg-17.jpg\n    </option>\n   </select>\n   <input accept=\"image/*\" class=\"form-control\" id=\"imgbg_up\" onchange=\"upload(this);save('imgbg','custom')\" type=\"file\"/>\n  </div>\n </div>\n <div class=\"mb-3 row\">\n  <label class=\"col-form-label col-sm-2\" for=\"bgbrightness\">\n   \u80cc\u666f\u4eae\u5ea6\n  </label>\n  <div class=\"col-sm-8\">\n   <input class=\"form-range\" id=\"bgbrightness\" max=\"200\" min=\"0\" onchange=\"save('bgbrightness',this.value,false);save('dark', this.value &lt; 100)\" oninput=\"$('#bgbrightness_value').text(this.value)\" step=\"1\" type=\"range\" value=\"100\"/>\n  </div>\n  <div class=\"col-sm-2\">\n   <span id=\"bgbrightness_value\">\n    100\n   </span>\n  </div>\n </div>\n <div class=\"mb-3 row\">\n  <label class=\"col-form-label col-sm-2\" for=\"color\">\n   \u906e\u7f69\u989c\u8272\n  </label>\n  <div class=\"col-sm-10\">\n   <input class=\"form-control form-control-color\" id=\"color2\" onchange=\"save('color',this.value)\" style=\"display: inline-block\" type=\"color\"/>\n  </div>\n </div>\n <div class=\"mb-3 row\">\n  <label class=\"col-form-label col-sm-2\" for=\"bgbrightness\">\n   \u906e\u7f69\u4e0d\u900f\u660e\u5ea6\n  </label>\n  <div class=\"col-sm-8\">\n   <input class=\"form-range\" id=\"coloropacity\" max=\"100\" min=\"0\" onchange=\"save('coloropacity',this.value);\" oninput=\"$('#coloropacity_value').text(this.value)\" step=\"1\" type=\"range\" value=\"100\"/>\n  </div>\n  <div class=\"col-sm-2\">\n   <span id=\"coloropacity_value\">\n    100\n   </span>\n  </div>\n </div>\n <div class=\"mb-3 row\">\n  <label class=\"col-form-label col-sm-2\" for=\"bgbrightness\">\n   \u80cc\u666f\u6a21\u7cca\n  </label>\n  <div class=\"col-sm-8\">\n   <input class=\"form-range\" id=\"bgblur\" max=\"100\" min=\"0\" onchange=\"save('bgblur',this.value);\" oninput=\"$('#bgblur_value').text(this.value)\" step=\"1\" type=\"range\" value=\"100\"/>\n  </div>\n  <div class=\"col-sm-2\">\n   <span id=\"bgblur_value\">\n    100\n   </span>\n  </div>\n </div>\n</div>\n<br/>\n<div class=\"form-check form-switch\">\n <input class=\"form-check-input\" id=\"dark\" onchange=\"save('dark',this.checked)\" role=\"switch\" type=\"checkbox\"/>\n <label class=\"form-check-label\" for=\"dark\">\n  \u6df1\u8272\u6a21\u5f0f\n </label>\n</div>\n<div class=\"form-check form-switch\">\n <input class=\"form-check-input\" id=\"no-anim\" onchange=\"save('no-anim',this.checked)\" role=\"switch\" type=\"checkbox\"/>\n <label class=\"form-check-label\" for=\"no-anim\">\n  \u5173\u95ed\u5143\u7d20\u52a8\u6001\u6548\u679c\n </label>\n</div>\n<hr/>\n<a class=\"btn btn-primary\" href=\"../home.html\">\n \u8fd4\u56de\n</a>\n<script>\n !(function() {\n                        \n\t$('#color').val(localStorage.getItem('color') || '#000000');\n\t$('#color2').val(localStorage.getItem('color') || '#000000');\n\t$('#no-anim').prop('checked', (localStorage.getItem('no-anim') || 'false') == 'true');\n\t$('#adv_bg').prop('checked', (localStorage.getItem('adv_bg') || 'true') == 'true');\n\t$('#dark').prop('checked', (localStorage.getItem('dark') || 'true') == 'true');\n\t$('#imgbg').val(localStorage.getItem('imgbg') || '');\n\t$('#bgbrightness').val(localStorage.getItem('bgbrightness') || '50');\n\t$('#bgbrightness_value').text($('#bgbrightness').val());\n\t$('#coloropacity').val(localStorage.getItem('coloropacity') || '0');\n\t$('#coloropacity_value').text($('#coloropacity').val());\n\t$('#bgblur').val(localStorage.getItem('bgblur') || '0');\n\t$('#bgblur_value').text($('#bgblur').val());\n\n\tif (localStorage.getItem('adv_bg') == 'true') {\n\t\t$('#basic_bg').addClass('hidden');\n\t} else {\n\t\t$('#advanced_bg').addClass('hidden');\n\t}\n\tif (localStorage.getItem('imgbg') != 'custom') {\n\t\t$('#imgbg_up').addClass('hidden');\n\t}\n\n                    })();\n</script>\n<script>\n function save(name, value, reload = true) {\n\t\tlocalStorage.setItem(name, value);\n\t\tif (reload) location.reload();\n\t}\n\tfunction clear() {\n\t\tvar password = $('#password').val();\n\t\tif (password == '\u5bc6\u7801') {\n\t\t\tlocalStorage.clear();\n\t\t\tlocation.href = '../home.html';\n\t\t} else {\n\t\t\t$('#Ask').modal('hide');\n\t\t\t$('#Error2').modal('show');\n\t\t}\n\t}\n\tfunction upload(input) {\n\t\tif (input.files && input.files[0]) {\n\t\t\tvar reader = new FileReader();\n\t\t\treader.onload = function (e) {\n\t\t\t\tlocalforage.setItem('imgbg', e.target.result);\n\t\t\t};\n\t\t\treader.readAsDataURL(input.files[0]);\n\t\t}\n\t}\n</script>\n", "rootdef": ".."}