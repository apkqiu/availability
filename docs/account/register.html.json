{"title": "\u67f3\u836b\u7720\u7434 | \u8d26\u53f7\u7ba1\u7406\n", "title_in": "\u67f3\u836b\u7720\u7434 | \u8d26\u53f7\u7ba1\u7406\n", "outbody": "<div class=\"modal fade\" data-bs-backdrop=\"static\" id=\"Info\" tabindex=\"-1\">\n <div class=\"modal-dialog modal-dialog modal-dialog-centered modal-dialog-scrollable\">\n  <div class=\"modal-content\">\n   <div class=\"modal-body\">\n    \u63d0\u4ea4\u6210\u529f\n    <br/>\n    \u6ce8\u518c\u4fe1\u606f\u4f1a\u4fdd\u5b58\u5230\u6d4f\u89c8\u5668\u7528\u6237\u6570\u636e\u4e2d\n   </div>\n   <div class=\"modal-footer\">\n    <a class=\"btn btn-primary\" href=\"index.html\" type=\"button\">\n     \u8fd4\u56de\n    </a>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"modal fade\" data-bs-backdrop=\"static\" id=\"Error\" tabindex=\"-1\">\n <div class=\"modal-dialog modal-dialog modal-dialog-centered modal-dialog-scrollable\">\n  <div class=\"modal-content\">\n   <div class=\"modal-body\">\n    \u4e24\u6b21\u8f93\u5165\u7684\u5bc6\u7801\u4e0d\u4e00\u81f4\n   </div>\n   <div class=\"modal-footer\">\n    <button class=\"btn btn-primary\" data-bs-dismiss=\"modal\" type=\"button\">\n     \u786e\u5b9a\n    </button>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"modal fade\" data-bs-backdrop=\"static\" id=\"Error2\" tabindex=\"-1\">\n <div class=\"modal-dialog modal-dialog modal-dialog-centered modal-dialog-scrollable\">\n  <div class=\"modal-content\">\n   <div class=\"modal-body\">\n    \u5bc6\u7801\u53ea\u80fd\u5305\u62ec\u6570\u5b57\uff0c\u5b57\u6bcd\uff0c\u4e0b\u5212\u7ebf\n   </div>\n   <div class=\"modal-footer\">\n    <button class=\"btn btn-primary\" data-bs-dismiss=\"modal\" type=\"button\">\n     \u786e\u5b9a\n    </button>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"modal fade\" data-bs-backdrop=\"static\" id=\"Error3\" tabindex=\"-1\">\n <div class=\"modal-dialog modal-dialog modal-dialog-centered modal-dialog-scrollable\">\n  <div class=\"modal-content\">\n   <div class=\"modal-body\">\n    \u8f93\u5165\u503c\u4e0d\u80fd\u4e3a\u7a7a\n   </div>\n   <div class=\"modal-footer\">\n    <button class=\"btn btn-primary\" data-bs-dismiss=\"modal\" type=\"button\">\n     \u786e\u5b9a\n    </button>\n   </div>\n  </div>\n </div>\n</div>\n", "body": "<h1>\n \u6ce8\u518c\n</h1>\n<script>\n !(function() {\n                        \n    function register() {\n        var username = $('#username').val();\n        var password = $('#password').val();\n        var password2 = $('#password2').val();\n        if (password != password2) {\n            $('#Error').modal('show');\n            return;\n        }\n        if (/\\W/g.test(password)) {\n            $('#Error2').modal('show');\n            return;\n        }\n        if (username == '' || password == '' || password2 == '') {\n            $('#Error3').modal('show');\n            return;\n        }\n        localStorage.setItem('username', JSON.stringify(username));\n        localStorage.setItem('password', JSON.stringify(password));\n        localStorage.setItem('accountBe', 'true');\n        $('#Info').modal('show');\n    }\n\n                    })();\n</script>\n<div>\n <!--\u6807\u7b7e\u5bf9\u9f50\uff0c\u6587\u672c\u6846\u5bf9\u9f50\uff0c\u5bbd\u5ea64/12-->\n <div class=\"form-group row m-3\">\n  <label class=\"col-sm-4 col-form-label\" for=\"username\">\n   \u7528\u6237\u540d\n  </label>\n  <div class=\"col-sm-8\">\n   <input class=\"form-control\" id=\"username\" name=\"username\" placeholder=\"\u7528\u6237\u540d\" type=\"text\"/>\n  </div>\n </div>\n <div class=\"form-group row m-3\">\n  <label class=\"col-sm-4 col-form-label\" for=\"password\">\n   \u5bc6\u7801\n  </label>\n  <div class=\"col-sm-8\">\n   <input class=\"form-control\" id=\"password\" name=\"password\" placeholder=\"\u5bc6\u7801\" type=\"password\"/>\n  </div>\n </div>\n <div class=\"form-group row m-3\">\n  <label class=\"col-sm-4 col-form-label\" for=\"password2\">\n   \u786e\u8ba4\u5bc6\u7801\n  </label>\n  <div class=\"col-sm-8\">\n   <input class=\"form-control\" id=\"password2\" name=\"password2\" placeholder=\"\u786e\u8ba4\u5bc6\u7801\" type=\"password\"/>\n  </div>\n </div>\n <div class=\"form-group row m-3\">\n  <div class=\"col-sm-8 offset-sm-4\">\n   <button class=\"btn btn-primary\" onclick=\"register()\">\n    \u6ce8\u518c\n   </button>\n  </div>\n </div>\n</div>\n", "rootdef": ".."}