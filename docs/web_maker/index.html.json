{"title": "\u68d5\u4ead\u9701\u96ea | \u81ea\u5236\u7f51\u9875\n", "title_in": "\u68d5\u4ead\u9701\u96ea | \u81ea\u5236\u7f51\u9875\n", "body": "<h1>\n \u81ea\u5236\u7f51\u9875\n</h1>\n<div class=\"list-group\" id=\"files\">\n</div>\n<script>\n !(function() {\n                        \n    // \u4ecelocalstorage\u83b7\u53d6\u6587\u4ef6\u6570\u636e\n    var files = JSON.parse(localStorage.getItem('web_editor_files') || '[]');\n    $('<a></a>')\n        .addClass('list-group-item btn btn-success')\n        .css('border-radius', '5px 5px 0px 0px ')\n        .attr('href', '../web_maker/edit.html?id=null&id=null') // \u5176\u5b9e\u6211\u4e5f\u4e0d\u77e5\u9053\u4e3a\u4ec0\u4e48\u8981\u52a0\u4e24\u4e2aid\n        .text('\u6dfb\u52a0\u65b0\u6587\u4ef6')\n        .appendTo($('#files'));\n\n    // \u904d\u5386\u6587\u4ef6\u6570\u636e\uff0c\u751f\u6210\u5217\u8868\u9879\n    files.forEach(function (file) {\n        $('<div></div>')\n            .addClass('list-group-item')\n            .append($('<span></span>').text(file.name))\n            .append($('<br>'))\n            .append(\n                $('<button></button>')\n                    .addClass('btn btn-danger btn-sm m-1')\n                    .text('\u5220\u9664')\n                    .click(function () {\n                        var files = JSON.parse(localStorage.getItem('web_editor_files') || '[]');\n                        files = files.filter(function (f) {\n                            return f.id !== file.id;\n                        });\n                        localStorage.setItem('web_editor_files', JSON.stringify(files));\n                        localforage.removeItem(file.id);\n                        location.reload();\n                    })\n            )\n            .append(\n                $('<a></a>')\n                    .addClass('btn btn-primary btn-sm m-1')\n                    .attr('href', '../web_maker/edit.html?id=' + file.id+\"&id=\"+file.id)\n                    .text('\u7f16\u8f91')\n            )\n            .append(\n                $('<button></button>')\n                    .addClass('btn btn-warning btn-sm m-1')\n                    .text('\u91cd\u547d\u540d')\n                    .click(function () {\n                        var files = JSON.parse(localStorage.getItem('web_editor_files') || '[]');\n                        // \u627e\u5230\u5f53\u524d\u7684ID\u7684\u7d22\u5f15\n                        var index = files.findIndex(function (f) {\n                            return f.id === file.id;\n                        });\n                        // \u5f39\u51fa\u91cd\u547d\u540d\u7a97\u53e3\n                        var new_name = prompt('\u8bf7\u8f93\u5165\u65b0\u7684\u6587\u4ef6\u540d', files[index].name);\n                        if (new_name) {\n                            files[index].name = new_name;\n                            localStorage.setItem('web_editor_files', JSON.stringify(files));\n                            location.reload();\n                        }\n                    })\n            )\n            .append(\n                $('<button></button>')\n                    .addClass('btn btn-info btn-sm m-1')\n                    .text('\u590d\u5236')\n                    .click(function () {\n                        var files = JSON.parse(localStorage.getItem('web_editor_files') || '[]');\n                        // \u627e\u5230\u5f53\u524d\u7684ID\u7684\u7d22\u5f15\n                        var index = files.findIndex(function (f) {\n                            return f.id === file.id;\n                        });\n                        // \u590d\u5236\u6587\u4ef6\n                        var new_file = {};\n                        new_file.name = files[index].name + ' - \u526f\u672c';\n                        new_file.id = new Date().getTime().toString(36);\n                        files.push(new_file);\n                        localStorage.setItem('web_editor_files', JSON.stringify(files));\n                        localforage.getItem(files[index].id).then(function (value) {\n                            localforage.setItem(new_file.id, value);\n                        });\n                        location.reload();\n                    })\n            )\n            .appendTo($('#files'));\n    });\n\n                    })();\n</script>\n", "rootdef": ".."}