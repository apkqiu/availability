{"title": "\u68d5\u4ead\u9701\u96ea | \u81ea\u5236\u7f51\u9875\n", "title_in": "\u68d5\u4ead\u9701\u96ea | \u81ea\u5236\u7f51\u9875\n", "outbody": "<div class=\"modal fade\" id=\"propModal\" tabindex=\"-1\">\n <div class=\"modal-dialog modal-fullscreen modal-lg\">\n  <div class=\"modal-content\">\n   <div class=\"modal-header\">\n    <h1 class=\"modal-title fs-5\" id=\"header\">\n     \u5c5e\u6027\n    </h1>\n    <button class=\"btn-close\" data-bs-dismiss=\"modal\" type=\"button\">\n    </button>\n   </div>\n   <div class=\"modal-body\">\n    <div id=\"prop-general\">\n     <h3>\n      \u901a\u7528\n     </h3>\n     <table class=\"w-100 table\">\n      <tr>\n       <td>\n        \u5143\u7d20ID\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"id\" type=\"text\"/>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u5957\u7528\u5143\u7d20\u6837\u5f0f\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"class\" placeholder=\"\u9ed8\u8ba4\u6a21\u677f\" type=\"text\"/>\n       </td>\n      </tr>\n     </table>\n    </div>\n    <div id=\"prop-text\">\n     <h3>\n      \u6587\u672c\n     </h3>\n     <table class=\"w-100 table\">\n      <tr>\n       <td>\n        \u6587\u672c\u5185\u5bb9\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"text\"/>\n       </td>\n      </tr>\n     </table>\n    </div>\n    <div id=\"prop-link\">\n     <h3>\n      \u8d85\u94fe\u63a5\n     </h3>\n     <table class=\"w-100 table\">\n      <tr>\n       <td>\n        \u94fe\u63a5\u5730\u5740\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"href\"/>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u94fe\u63a5\u6587\u672c\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"link_text\"/>\n       </td>\n      </tr>\n     </table>\n    </div>\n    <div id=\"prop-style\">\n     <h3>\n      CSS\u6837\u5f0f\n     </h3>\n     <table class=\"w-100 table\">\n      <tr>\n       <td>\n        <h4>\n         \u5b57\u4f53\n        </h4>\n       </td>\n       <td>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u5b57\u4f53\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"css-font-family\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\"/>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u989c\u8272\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"css-color\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\"/>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u5b57\u4f53\u5927\u5c0f\n       </td>\n       <td>\n        <div class=\"input-group\">\n         <input class=\"form-control\" id=\"css-font-size\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\" type=\"number\"/>\n         <select class=\"form-select\" id=\"css-font-size-unit\">\n          <option disabled=\"\">\n           \u865a\u62df\u5927\u5c0f\n          </option>\n          <option value=\"px\">\n           px - \u50cf\u7d20\n          </option>\n          <option value=\"pt\">\n           pt - \u78c5\uff08word\u98ce\u683c\uff09\n          </option>\n          <option value=\"em\">\n           em - \u76f8\u5bf9\u5927\u5c0f\uff08\u7f29\u653e\u500d\u6570\uff0c\u76f8\u5bf9\u4e8e\u7236\u7ea7div\u7684\u8bbe\u5b9a\u7684\u5927\u5c0f\uff09\n          </option>\n          <option value=\"rem\">\n           rem - \u76f8\u5bf9\u7edd\u5bf9\u5927\u5c0f\uff08\u7f29\u653e\u500d\u6570\uff0c\u76f8\u5bf9\u4e8e\u5b57\u4f53\u7684\u5927\u5c0f\uff09\n          </option>\n          <option disabled=\"\">\n           \u771f\u5b9e\u5927\u5c0f\n          </option>\n          <option value=\"cm\">\n           cm - \u5398\u7c73\n          </option>\n          <option value=\"mm\">\n           mm - \u6beb\u7c73\n          </option>\n         </select>\n        </div>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u5b57\u4f53\u53d8\u4f53\n       </td>\n       <td>\n        <div class=\"input-group\">\n         <select class=\"form-select\" id=\"css-font-weight\">\n          <option value=\"\">\n           \u52a0\u7c97\uff1a\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\n          </option>\n          <option value=\"normal\">\n           \u4e0d\u52a0\u7c97\n          </option>\n          <option value=\"bold\">\n           \u52a0\u7c97\n          </option>\n          <option value=\"bolder\">\n           \u66f4\u7c97\n          </option>\n         </select>\n         <select class=\"form-select\" id=\"css-font-style\">\n          <option value=\"\">\n           \u503e\u659c\uff1a\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\n          </option>\n          <option value=\"normal\">\n           \u4e0d\u503e\u659c\n          </option>\n          <option value=\"italic\">\n           \u659c\u4f53\n          </option>\n          <option value=\"oblique\">\n           \u503e\u659c\n          </option>\n         </select>\n         <select class=\"form-select\" id=\"css-text-decoration\">\n          <option value=\"\">\n           \u7ebf\u6761\uff1a\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\n          </option>\n          <option value=\"none\">\n           \u65e0\u9644\u52a0\u7ebf\u6761\n          </option>\n          <option value=\"underline\">\n           \u4e0b\u5212\u7ebf\n          </option>\n          <option value=\"overline\">\n           \u4e0a\u5212\u7ebf\n          </option>\n          <option value=\"line-through\">\n           \u5220\u9664\u7ebf\n          </option>\n         </select>\n        </div>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        <h4>\n         \u80cc\u666f\n        </h4>\n       </td>\n       <td>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u80cc\u666f\u989c\u8272\n       </td>\n       <td>\n        <input class=\"form-control\" id=\"css-background-color\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\"/>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        <h4>\n         \u5e03\u5c40