 </a>\n  <h4>\n   \u5143\u7d20\u6811\n  </h4>\n  <div id=\"element-tree\" style=\"overflow: auto; white-space: nowrap\">\n  </div>\n </div>\n <div class=\"col-md-6\">\n  <h4>\n   \u9884\u89c8\n  </h4>\n  <div id=\"sandbox\" style=\"overflow: auto\">\n  </div>\n </div>\n</div>\n<script>\n !(function() {\n                        \n    function saveasf() {\n        var name = prompt('\u53d6\u4e2a\u540d\u5b57\u5457');\n        if (name == null) {\n            return;\n        }\n        var localstorage_data = JSON.parse(localStorage.getItem('web_editor_files') || '[]');\n        var new_data = {\n            name: name,\n            id: new Date().getTime().toString(36),\n        };\n        localstorage_data.push(new_data);\n        id = new_data.id;\n        localstorage_data = JSON.stringify(localstorage_data);\n        localStorage.setItem('web_editor_files', localstorage_data);\n    }\n    function savef() {\n        if (id == 'null') {\n            saveasf();\n        }\n        localforage.setItem(id, document.getElementById('sandbox').innerHTML);\n        document.getElementById('save').classList.remove('btn-primary');\n        document.getElementById('save').classList.add('btn-success');\n        setTimeout(() => {\n            document.getElementById('save').classList.remove('btn-success');\n            document.getElementById('save').classList.add('btn-primary');\n        }, 3000);\n    }\n    function openf() {\n        // choose file\n        var input = document.createElement('input');\n        input.type = 'file';\n        input.accept = '.qysf';\n        input.onchange = function (e) {\n            var file = e.target.files[0];\n            var reader = new FileReader();\n            reader.onload = function (e) {\n                var html = atob(e.target.result);\n                document.getElementById('sandbox').innerHTML = html;\n                make_element_tree();\n            };\n            reader.readAsText(file);\n        };\n        input.click();\n    }\n\n    function add_element(element_name, parent) {\n        $('#addModal').modal('hide');\n        var element = document.createElement(element_name);\n        parent.appendChild(element);\n        make_element_tree();\n    }\n    function clear_element_tree() {\n        document.getElementById('element-tree').innerHTML = '';\n    }\n\n    function lock_local(args, func) {\n        return function (arg) {\n            func(arg, args);\n        };\n    }\n    function make_root_toolbar() {\n        var add = document.createElement('button');\n        add.className = 'btn btn-success btn-sm m-1';\n        add.innerHTML = '\u6dfb\u52a0';\n        add.onclick = function () {\n            showAddModal(document.getElementById('sandbox'));\n            make_element_tree();\n        };\n        document.getElementById('element-tree').appendChild(add);\n    }\n    var addable = ['div', 'ul', 'ol', 'li', 'table', 'tr', 'td', 'thead', 'tbody', 'tfoot'];\n    function test_element(e, list) {\n        for (var item of list) {\n            if ($(e).is(item)) return true;\n        }\n        return false;\n    }\n    function make_element_tree(element = $('#sandbox'), tree = $('#element-tree'), deepth = 0) {\n        if (deepth == 0) {\n            clear_element_tree();\n            make_root_toolbar();\n        }\n        // prevent legacy call\n        element = $(element);\n        tree = $(tree);\n\n        if (element.children().length > 0) {\n            var ul = $('<ul></ul>');\n            ul.css('list-style-type', 'none');\n            for (var i = 0; i < element.children().length; i++) {\n                let bind_element = $(element.children()[i]);\n                var details = $('<details></details>')\n                    .attr('open', true)\n                    .append(\n                        $('<summary></summary>')\n                            .append(\n                                $('<span></span>').text(\n                                    test_element(bind_element, addable)\n                                        ? bind_element[0].tagName\n                                        : bind_element[0].tagName + ' (' + bind_element.text() + ')'\n                                )\n                            )\n                            .append(\n                                $('<div></div')\n                                    .css('display', 'inline-block')\n                                    .append(\n                                        $('<button></button>')\n                                            .addClass('btn btn-danger btn-sm m-1')\n                                            .text('\u5220\u9664')\n                                            .click(function () {\n                                                bind_element.remove();\n                                                make_element_tree();\n                                            })\n                                    )\n                                    .append(\n                                        $('<button></button>')\n                                            .addClass('btn btn-info btn-sm m-1')\n                                            .text('\u5c5e\u6027')\n                                            .click(() => showPropModal(bind_element[0]))\n                                    )\n                                    .append(() => {\n                                        if (addable.includes(bind_element[0].tagName.toLowerCase()))\n                                            return $('<button></button>')\n                                                .addClass('btn btn-success btn-sm m-1')\n                                                .text('\u6dfb\u52a0')\n                                                .click(() => {\n                                                    if (test_element(bind_element, ['ul', 'ol'])) {\n                                                        add_element('li', bind_element[0]);\n                                                    } else if (test_element(bind_element, ['table'])) {\n                                                        showTableAddModal(bind_element[0]);\n                                                    } else if (test_element(bind_element, ['thead', 'tbody', 'tfoot'])) {\n                                                        add_element('tr', bind_element[0]);\n                                                    } else if (test_element(bind_element, ['tr'])) {\n                                                        add_element('td', bind_element[0]);\n                                                    } else {\n                                                        showAddModal(bind_element[0]);\n                                                    }\n                                                });\n\n                                        return null;\n                                    })\n                            )\n                            .on('toggle', function () {\n                                $(this).attr('open', true);\n                            })\n                    );\n                ul.append($('<li></li>').append(details));\n                make_element_tree(element.children()[i], details, deepth + 1);\n            }\n            tree.append(ul);\n        }\n    }\n    \n    var id = getarg('id');\n    if (id != 'null') {\n        localforage.getItem(id).then((value) => {\n            document.getElementById('sandbox').innerHTML = value;\n            4;\n            make_element_tree();\n        });\n    }\n    make_element_tree();\n\n                    })();\n</script>\n", "rootdef": ".."}