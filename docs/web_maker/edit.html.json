\u5355\u4f4d\n         </span>\n         <select class=\"form-select\" id=\"css-margin-unit\">\n          <option disabled=\"\">\n           \u865a\u62df\u5927\u5c0f\n          </option>\n          <option value=\"px\">\n           px - \u50cf\u7d20\n          </option>\n          <option disabled=\"\">\n           \u771f\u5b9e\u5927\u5c0f\n          </option>\n          <option value=\"cm\">\n           cm - \u5398\u7c73\n          </option>\n          <option value=\"mm\">\n           mm - \u6beb\u7c73\n          </option>\n         </select>\n        </div>\n       </td>\n      </tr>\n      <tr>\n       <td>\n        \u5185\u8fb9\u8ddd\n       </td>\n       <td>\n        <div class=\"input-group\">\n         <span class=\"input-group-text\">\n          \u4e0a\n         </span>\n         <input class=\"form-control\" id=\"css-padding-top\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\" type=\"number\"/>\n        </div>\n        <div class=\"input-group\">\n         <span class=\"input-group-text\">\n          \u53f3\n         </span>\n         <input class=\"form-control\" id=\"css-padding-right\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\" type=\"number\"/>\n        </div>\n        <div class=\"input-group\">\n         <span class=\"input-group-text\">\n          \u4e0b\n         </span>\n         <input class=\"form-control\" id=\"css-padding-bottom\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\" type=\"number\"/>\n        </div>\n        <div class=\"input-group\">\n         <span class=\"input-group-text\">\n          \u5de6\n         </span>\n         <input class=\"form-control\" id=\"css-padding-left\" placeholder=\"\u4e0e\u5957\u7528\u6a21\u677f\u4e00\u81f4\" type=\"number\"/>\n        </div>\n        <hr/>\n        <div class=\"input-group\">\n         <span class=\"input-group-text\">\n          \u5355\u4f4d\n         </span>\n         <select class=\"form-select\" id=\"css-padding-unit\">\n          <option disabled=\"\">\n           \u865a\u62df\u5927\u5c0f\n          </option>\n          <option value=\"px\">\n           px - \u50cf\u7d20\n          </option>\n          <option disabled=\"\">\n           \u771f\u5b9e\u5927\u5c0f\n          </option>\n          <option value=\"cm\">\n           cm - \u5398\u7c73\n          </option>\n          <option value=\"mm\">\n           mm - \u6beb\u7c73\n          </option>\n         </select>\n        </div>\n       </td>\n      </tr>\n     </table>\n    </div>\n    <div id=\"preview\">\n     <h3>\n      \u5143\u7d20\u9884\u89c8\n     </h3>\n     <input id=\"preview-checkbox\" onchange=\"set_transparenty()\" type=\"checkbox\"/>\n     \u4f53\u73b0\u900f\u660e\u5ea6\n     <script>\n      !(function() {\n                        \n                        function set_transparenty() {\n                            var checkbox = document.getElementById('preview-checkbox');\n                            if (checkbox.checked) {\n                                document.getElementById('preview-box').style = `\n\n  background-color: #fff;\n  background-image: linear-gradient(45deg, #eee 25%, transparent 25%, transparent 75%, #eee 75%),\n    linear-gradient(45deg, #eee 25%, transparent 25%, transparent 75%, #eee 75%);\n  background-position: 0 0, 25px 25px;\n  background-size: 50px 50px;\n`;\n                            } else {\n                                document.getElementById('preview-box').style = '';\n                            }\n                        }\n                    \n                    })();\n     </script>\n     <div id=\"preview-box\">\n     </div>\n    </div>\n   </div>\n   <div class=\"modal-footer\">\n    <button class=\"btn btn-secondary\" data-bs-dismiss=\"modal\" type=\"button\">\n     \u53d6\u6d88\n    </button>\n    <button class=\"btn btn-primary\" onclick=\"saveProp()\" type=\"button\">\n     \u4fdd\u5b58\n    </button>\n   </div>\n  </div>\n </div>\n</div>\n<script>\n !(function() {\n                        \n    var currentShow = null;\n    var propText = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'span'];\n    var hyperLink = ['a'];\n    var interval = null;\n    function showPropModal(element) {\n        $('#propModal').modal('show');\n        $('#header').text(element.tagName + '\u6807\u7b7e');\n        $('#id').val(element.id);\n        $('#class').val(element.className);\n        // prop: text\n        if (propText.includes(element.tagName.toLowerCase())) {\n            $('#prop-text').show();\n            $('#text').val(element.innerText);\n        } else {\n            $('#prop-text').hide();\n        }\n        // prop: link\n        if (hyperLink.includes(element.tagName.toLowerCase())) {\n            $('#prop-link').show();\n            $('#href').val(element.href);\n            $('#link_text').val(element.innerText);\n        } else {\n            $('#prop-link').hide();\n        }\n        // prop: style\n        $('#css-color').val(element.style.color);\n        var size = element.style.fontSize;\n        if (size == '') {\n            $('#css-font-size').val('');\n            $('#css-font-size-unit').val('px');\n        } else {\n            $('#css-font-size').val(size.match(/(\\d+)/g)[0]);\n            $('#css-font-size-unit').val(size.match(/(\\D+)$/g)[0]);\n        }\n        $('#css-font-family').val(element.style.fontFamily);\n        $('#css-background-color').val(element.style.backgroundColor);\n        $('#css-font-weight').val(element.style.fontWeight);\n        $('#css-font-style').val(element.style.fontStyle);\n        $('#css-text-decoration').val(element.style.textDecoration);\n        var width = element.style.width;\n        if (width == '') {\n            $('#css-width').val('');\n            $('#css-width-unit').val('px');\n        } else {\n            $('#css-width').val(width.match(/(\\d+)/g)[0]);\n            $('#css-width-unit').val(width.match(/(\\D+)$/g)[0]);\n        }\n        var height = element.style.height;\n        if (height == '') {\n            $('#css-height').val('');\n            $('#css-height-unit').val('px');\n        } else {\n            $('#css-height').val(height.match(/(\\d+)/g)[0]);\n            $('#css-height-unit').val(height.match(/(\\D+)$/g)[0]);\n        }\n        $('#css-overflow').val(element.style.overflow);\n        interval = setInterval(function () {\n            var ele = saveProp(false);\n            document.getElementById('preview-box').innerHTML = '';\n            document.getElementById('preview-box').appendChild(ele);\n        }, 1);\n        var margin = [element.style.marginTop, element.style.marginRight, element.style.marginBottom, element.style.marginLeft];\n        for (var i = 0; i < margin.length; i++) {\n            $('#css-margin-' + ['top', 'right', 'bottom', 'left'][i]).val(margin[i] ? margin[i].match(/(\\d+)/g)[0] : '');\n        }\n        $('#css-margin-unit').val(margin[0] !== '' ? margin[0].match(/(\\D+)$/g)[0] : 'px');\n        var padding = [element.style.paddingTop, element.style.paddingRight, element.style.paddingBottom, element.style.paddingLeft];\n        for (var i = 0; i < padding.length; i++) {\n            $('#css-padding-' + ['top', 'right', 'bottom', 'left'][i]).val(padding[i] ? padding[i].match(/(\\d+)/g)[0] : '');\n        }\n        $('#css-padding-unit').val(padding[0] !== '' ? padding[0].match(/(\\D+)$/g)[0] : 'px');\n\n        currentShow = element;\n    }\n    function saveProp(real = true) {\n        if (!real) {\n            var cshow = document.createElement(currentShow.tagName);\n        } else {\n            var cshow = currentShow;\n        }\n        cshow.id = $('#id').val();\n        cshow.className = $('#class').val();\n        if (propText.includes(cshow.tagName.toLowerCase())) {\n            cshow.innerText = $('#text').val();\n        }\n        if (hyperLink.includes(cshow.tagName.toLowerCase())) {\n            var href = $('#href').val();\n            if((!href.startsWith('http://') && !href.startsWith('https://')) && (href.indexOf(\":\")!=-1)) {\n                // Bad uri\n                cshow.href = \"\";\n            }else{\n                cshow.href = $('#href').val();\n            }\n            cshow.innerText = $('#link_text').val();\n        }\n        //style\n        cshow.style.color = $('#css-color').val();\n        cshow.style.fontSize = $('#css-font-size').val() ? $('#css-font-size').val() + $('#css-font-size-unit').val() : '';\n        cshow.style.fontFamily = $('#css-font-family').val();\n        cshow.style.backgroundColor = $('#css-background-color').val();\n        cshow.style.fontWeight = $('#css-font-weight').val();\n        cshow.style.fontStyle = $('#css-font-style').val();\n        cshow.style.textDecoration = $('#css-text-decoration').val();\n        cshow.style.width = $('#css-width').val() ? $('#css-width').val() + $('#css-width-unit').val() : '';\n        cshow.style.height = $('#css-height').val() ? $('#css-height').val() + $('#css-height-unit').val() : '';\n        cshow.style.overflow = $('#css-overflow').val();\n        cshow.style.marginTop = $('#css-margin-top').val() ? $('#css-margin-top').val() + $('#css-margin-unit').val() : '';\n        cshow.style.marginBottom = $('#css-margin-bottom').val() ? $('#css-margin-bottom').val() + $('#css-margin-unit').val() : '';\n        cshow.style.marginLeft = $('#css-margin-left').val() ? $('#css-margin-left').val() + $('#css-margin-unit').val() : '';\n        cshow.style.marginRight = $('#css-margin-right').val() ? $('#css-margin-right').val() + $('#css-margin-unit').val() : '';\n        cshow.style.paddingTop = $('#css-padding-top').val() ? $('#css-padding-top').val() + $('#css-padding-unit').val() : '';\n        cshow.style.paddingBottom = $('#css-padding-bottom').val() ? $('#css-padding-bottom').val() + $('#css-padding-unit').val() : '';\n        cshow.style.paddingLeft = $('#css-padding-left').val() ? $('#css-padding-left').val() + $('#css-padding-unit').val() : '';\n        cshow.style.paddingRight = $('#css-padding-right').val() ? $('#css-padding-right').val() + $('#css-padding-unit').val() : '';\n        if (real) {\n            clearInterval(interval);\n            $('#propModal').modal('hide');\n            make_element_tree();\n        } else {\n            return cshow;\n        }\n    }\n\n                    })();\n</script>\n<div class=\"modal fade\" id=\"addModal\" tabindex=\"-1\">\n <div class=\"modal-dialog\">\n  <div class=\"modal-content\">\n   <div class=\"modal-header\">\n    <h1 class=\"modal-title fs-5\" id=\"header\">\n     \u6dfb\u52a0\n    </h1>\n    <button class=\"btn-close\" data-bs-dismiss=\"modal\" type=\"button\">\n    </button>\n   </div>\n   <div class=\"modal-body\">\n    <div id=\"basic\">\n     <span>\n      \u6587\u672c\n     </span>\n     <div class=\"list-group\">\n      <a class=\"list-group-item\" href=\"javascript:add_element('p', wait_to_add)\">\n       \u6bb5\u843d (p)\n      </a>\n      <a class=\"list-group-item\" href=\"javascript:add_element('span', wait_to_add)\">\n       \u6587\u5b57 (span)\n      </a>\n      <a class=\"list-group-item\" href=\"javascript:add_element('h1', wait_to_add)\">\n       \u5927\u6807\u9898 (h1)\n      </a>\n      <a class=\"list-group-item\" href=\"javascript:add_element('h2', wait_to_add)\">\n       \u4e2d\u6807\u9898 (h2)\n      </a>\n      <a class=\"list-group-item\" href=\"javascript:add_element('h3', wait_to_add)\">\n       \u5c0f\u6807\u9898 (h3)\n      </a>\n     </div>\n     <span>\n      \u5e03\u5c40\n     </span>\n     <div class=\"list-group\">\n      <a class=\"list-group-item\" href=\"javascript:add_element('div', wait_to_add)\">\n       \u76d2\u5b50 (div)\n      </a>\n      <a class=\"list-group-item\" href=\"javascript:add_element('ul', wait_to_add)\">\n       \u65e0\u5e8f\u5217\u8868[\u00b7 \u00b7 \u00b7] (ul)\n      </a>\n      <a class=\"list-group-item\" href=\"javascript:add_element('ol', wait_to_add)\">\n       \u6709\u5e8f\u5217\u8868[1 2 3] (ol)\n 