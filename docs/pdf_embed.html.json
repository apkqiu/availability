{"title": "\u6d3d\u9690\u5c71\u623f | \u65b0\u95fb\n", "title_in": "\u6d3d\u9690\u5c71\u623f | \u65b0\u95fb\n", "body": "<style>\n .list-group-item,\n\t.list-group-item {\n\t\tbackground: transparent;\n\t}\n</style>\n<button class=\"btn\" id=\"changeview\">\n \u5207\u6362\u5230PDF\u89c6\u56fe\n</button>\n<hr/>\n<div class=\"row\">\n <div class=\"col-md-8\" id=\"content\">\n  <iframe class=\"hidden\" id=\"realpdf\" style=\"width: 100%; height: 100vh\">\n  </iframe>\n  <div id=\"pdf\" style=\"background-color: rgba(255, 255, 255, 0.5); backdrop-filter: blur(10px); overflow: auto\">\n  </div>\n </div>\n <div class=\"col-md-4\" id=\"ads\">\n  <h4>\n   \u4eba\u4eba\u5173\u6ce8\n  </h4>\n  <ul class=\"list-group list-group-flush\" id=\"recommend\">\n  </ul>\n </div>\n</div>\n<div id=\"comments\">\n</div>\n<script>\n !(function() {\n                        \n\tvar pdf_html_ver = getarg('html');\n\tvar pdf_orig = getarg('pdf');\n\tvar p = getarg('p');\n\tif (p) {\n\t\tpdf_html_ver = 'news/newspaper/zhoubao' + p + '.html';\n\t\tpdf_orig = './../components/pdf/web/viewer.html?file=../../../docs/res/pdf/zhoubao' + p + '.pdf';\n\t}\n\t$('#realpdf').attr('src', pdf_orig);\n\t$('#pdf').html('<div class=\"spinner-border\"></div>');\n\t$.get(pdf_html_ver, function (data) {\n\t\tdata = data.replaceAll('zhoubao' + p + '.files', 'news/newspaper/zhoubao' + p + '.files'); // regex\u592a\u597d\u7528\u4e86\n\t\t$('#pdf').html(data);\n\t});\n\tvar currentshow = 'html';\n\t$('#changeview').click(function () {\n\t\tif (currentshow == 'html') {\n\t\t\t$('#realpdf').removeClass('hidden');\n\t\t\t$('#pdf').addClass('hidden');\n\t\t\tcurrentshow = 'pdf';\n\t\t\t$(this).html('\u5207\u6362\u5230HTML\u89c6\u56fe');\n\t\t} else {\n\t\t\t$('#realpdf').addClass('hidden');\n\t\t\t$('#pdf').removeClass('hidden');\n\t\t\tcurrentshow = 'html';\n\t\t\t$(this).html('\u5207\u6362\u5230PDF\u89c6\u56fe');\n\t\t}\n\t});\n\t$('#recommend').html('<div class=\"spinner-border\"></div>');\n\t$.get('popular.json').then(function (data) {\n\t\t$('#recommend').html('');\n\t\t// key: title, value: url\n\t\tfor (var key in data) {\n\t\t\tvar url = data[key];\n\t\t\tif (url.startsWith('!')) {\n\t\t\t\turl = 'pdf_embed.html#' + url.substring(1);\n\t\t\t} else {\n\t\t\t\turl = 'embed.html?' + url;\n\t\t\t}\n\t\t\t$('#recommend').append(\"<li class='list-group-item'><a href='\" + url + \"'>\" + key + '</a></li>');\n\t\t}\n\t});\n\n                    })();\n</script>\n<script>\n !(function() {\n                        \n\t$('.giscus').appendTo('#comments');\n\n                    })();\n</script>\n", "rootdef": "."}