 {\n        var url;\n        if(resource.startsWith(\"!\")){\n            resource = resource.substring(1);\n            type = resource[0];\n            resource = resource.substring(1).replaceAll('.md', '.html');\n            type = {\n                p: 'poems',\n                w: 'words',\n                s: 'songs',\n                c: 'writings',\n            }[type];\n            url = 'text/' + type + '/' + resource;\n        }else{\n            url = 'news/content/' + resource\n        }\n\t\t$.get(url).then(function (data) {\n\t\t\tdata = data.replace(/(.+).files/g, 'news/newspaper/$1.files');\n\t\t\t$('#content').html(data);\n\t\t\t$('#content img').click(function () {\n\t\t\t\t$('#image').attr('src', $(this).attr('src'));\n\t\t\t\t$('#newtab').attr('href', $(this).attr('src'));\n\t\t\t\t$('#download').attr('href', $(this).attr('src'));\n\t\t\t\t$('#imageModal').modal('show');\n\t\t\t\t$('#zoom').val('100').trigger('input');\n\t\t\t\trotation = 0n;\n\t\t\t\t$('#image').css('transform', 'rotate(0deg)');\n\t\t\t});\n\t\t\t$('.footnote-ref>a').attr('no-intercept', 'true');\n\t\t\t$('.footnote-backref').attr('no-intercept', 'true');\n\t\t});\n\t} else {\n\t\t$('#content').html('\u6ca1\u6709\u627e\u5230\u8d44\u6e90\uff0c\u8bf7\u68c0\u67e5URL');\n\t}\n\t$('#recommend').html('<div class=\"spinner-border\"></div>');\n\t$.get('popular.json').then(function (data) {\n\t\t$('#recommend').html('');\n\t\t// key: title, value: url\n\t\tfor (var key in data) {\n\t\t\tvar url = data[key];\n\t\t\tif (url.startsWith('!')) {\n\t\t\t\turl = 'pdf_embed.html#' + url.substring(1);\n\t\t\t} else {\n\t\t\t\turl = 'embed.html?' + url;\n\t\t\t}\n\t\t\t$('#recommend').append(\"<li class='list-group-item'><a href='\" + url + \"'>\" + key + '</a></li>');\n\t\t}\n\t});\n\n                    })();\n  </script>\n  <script>\n   !(function() {\n                        \n\t$('.giscus').appendTo('#comments');\n\n                    })();\n  </script>\n </br>\n</br>\n", "rootdef": "."}